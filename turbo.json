{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": ["DATABASE_URL"]
    },
    "e2e": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "passThroughEnv": ["CI"]
    }
  }
}
