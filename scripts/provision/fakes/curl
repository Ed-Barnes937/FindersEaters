#!/usr/bin/env bash
# Fake curl for provision.sh --dry-run (see _fake.sh). Serves two things:
#   - Workers AI: answers the dev-set Clef request with the recorded response
#     (fixtures/clef-dev-response.json) for any token without "revoked" in it,
#     and keeps the request body so tests can check what was sent.
#   - /health: ok for a deployed app on <app>.fly.dev, and on a custom host
#     once the app has a certificate for it.
# shellcheck source=_fake.sh
. "$(dirname "$0")/_fake.sh"

out='' format='' data='' url='' auth=''
while (($#)); do
  case "$1" in
    -o) out="$2" && shift ;;
    -w) format="$2" && shift ;;
    --data-binary) data="${2#@}" && shift ;;
    -K)
      while IFS= read -r line; do
        case "$line" in
          url\ =*) url="$(sed -E 's/^url = "(.*)"$/\1/' <<<"$line")" ;;
          header\ =\ \"Authorization:*) auth="$(sed -E 's/^header = "Authorization: Bearer (.*)"$/\1/' <<<"$line")" ;;
        esac
      done
      shift
      ;;
    -H | --max-time) shift ;;
    -*) ;;
    *) url="$1" ;;
  esac
  shift
done

respond() { # STATUS BODY
  if [[ -n "$out" ]]; then printf '%s' "$2" >"$out"; else printf '%s' "$2"; fi
  [[ "$format" == '%{http_code}' ]] && printf '%s' "$1"
  return 0
}

fixtures="$(dirname "$0")/../fixtures"
case "$url" in
  https://api.cloudflare.com/client/v4/accounts/*/ai/run/@cf/cloudflare/clef)
    put cloudflare/last-request.json "$(cat "$data")"
    account="$(sed -E 's#.*/accounts/([^/]+)/ai/run/.*#\1#' <<<"$url")"
    if [[ -z "$auth" || "$auth" == *revoked* || -z "$account" ]]; then
      respond 401 '{"result":null,"success":false,"errors":[{"code":10000,"message":"Authentication error"}],"messages":[]}'
    else
      respond 200 "$(cat "$fixtures/clef-dev-response.json")"
    fi
    ;;
  https://*.fly.dev/health)
    app="$(sed -E 's#https://([^.]+)\.fly\.dev/health#\1#' <<<"$url")"
    has "fly/deployed/$app" || {
      echo "curl: (6) Could not resolve host: $app.fly.dev" >&2
      exit 6
    }
    respond 200 '{"status":"ok","database":{"ok":true,"latencyMs":12,"migrationsApplied":3}}'
    ;;
  https://*/health)
    host="$(sed -E 's#https://([^/]+)/health#\1#' <<<"$url")"
    for cert in "$F"/fly/certs/*/"$host"; do
      app="$(basename "$(dirname "$cert")")"
      if [[ -e "$cert" ]] && has "fly/deployed/$app"; then
        respond 200 '{"status":"ok","database":{"ok":true,"latencyMs":12,"migrationsApplied":3}}'
        exit 0
      fi
    done
    echo "curl: (35) TLS connect error for $host" >&2
    exit 35
    ;;
  *) die "unexpected URL $url" ;;
esac
